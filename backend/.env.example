# ===================================
# CONFIGURATION MARSAI FESTIVAL
# ===================================
# Copier ce fichier en .env et remplir les valeurs

# ===================================
# BASE DE DONNÉES
# ===================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=marsai_festival

# ===================================
# SÉCURITÉ & AUTHENTIFICATION
# ===================================
# JWT Secret - Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Session Secret - Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ===================================
# COMPTES PAR DÉFAUT
# ===================================
# Admin par défaut (créé au démarrage si inexistant)
ADMIN_DEFAULT_EMAIL=admin@marsai.com
ADMIN_DEFAULT_PASSWORD=

# Jury de test (optionnel, pour le développement)
JURY_DEFAULT_EMAIL=jury@test.fr
JURY_DEFAULT_PASSWORD=
JURY_DEFAULT_NAME=Jury Test

# ===================================
# GOOGLE OAUTH & YOUTUBE
# ===================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ===================================
# STOCKAGE SCALEWAY S3
# ===================================
SCALEWAY_ENDPOINT=https://s3.fr-par.scw.cloud
SCALEWAY_REGION=fr-par
SCALEWAY_BUCKET_NAME=
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_FOLDER=uploads

# ===================================
# APPLICATION
# ===================================
# Environnement (development | production)
NODE_ENV=development

# Port du serveur backend
PORT=3000

# URL du frontend (pour les emails et redirections)
FRONTEND_URL=http://localhost:5173

# ===================================
# EMAIL (OPTIONNEL)
# ===================================
# Configuration du service d'emailing
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@marsai.com
